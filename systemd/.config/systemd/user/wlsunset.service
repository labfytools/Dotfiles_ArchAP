[Unit]
Description=Wayland color temperature (wlsunset)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
# CONTRACT: le launcher lit les préférences locales puis exec wlsunset ;
# systemd garde ainsi le PID et le contrôle exclusif de la correction gamma.
ExecStart=/usr/bin/python /home/fy59/.local/bin/night-light-manager.py launch
# WHY: wlsunset 0.4.0 refuse -T == -t ; son SIGUSR1 documenté permet
# AUTO -> FORCE_HIGH -> FORCE_LOW lorsque le mode ON est demandé.
ExecStartPost=/usr/bin/python /home/fy59/.local/bin/night-light-manager.py post-start
Restart=on-failure

[Install]
WantedBy=graphical-session.target
