[Unit]
Description=Cliphist text watcher
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# CONTRACT: newly created database files remain private; no retention change.
UMask=0077
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && exit 0; sleep 0.1; done; echo "No Wayland socket" >&2; exit 1'
# WHY: make the intended text MIME explicit alongside the PNG collector.
ExecStart=/usr/bin/wl-paste --type text --watch cliphist store
Restart=on-failure

[Install]
WantedBy=graphical-session.target
