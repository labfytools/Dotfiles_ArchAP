[Unit]
Description=Trainlog Bluetooth RFCOMM agent
ConditionPathExists=/home/fy59/.config/trainlog/sync-generation-config-v1.json

[Service]
Type=simple
ExecCondition=/usr/bin/grep -Eq '"bluetooth_enabled"[[:space:]]*:[[:space:]]*true' "/home/fy59/.config/trainlog/sync-generation-config-v1.json"
# Entrée réelle du rollout (vérifiée ; choisir la version à déployer explicitement).
ExecStart=/home/fy59/.local/share/trainlog/rollouts/program-recalage-v1-3a4ec34/desktop/bin/trainlog-btd --config /home/fy59/.config/trainlog/sync-generation-config-v1.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
