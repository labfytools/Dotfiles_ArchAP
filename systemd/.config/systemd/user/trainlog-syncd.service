[Unit]
Description=Trainlog automatic synchronization agent

[Service]
Type=simple
# Le wrapper du rollout publie les bons adaptateurs et appelle sync-once.
# Ne jamais réutiliser les anciens chemins ~/Documents/Development/trainlog.
ExecStart=/home/fy59/.local/share/trainlog/rollouts/program-recalage-v1-3a4ec34/desktop/bin/trainlog-syncd --interval 3
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
