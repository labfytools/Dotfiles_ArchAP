[Unit]
Description=QuickShell labfy-sway et serveur de notifications
PartOf=wayland-session@sway.desktop.target
After=wayland-session@sway.desktop.target

[Service]
Type=simple
# Qt 6.12 popup reposition ownership fix; rebuild after Qt updates.
ExecStart=%h/.local/bin/labfy-quickshell -c labfy-sway --no-color
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=wayland-session@sway.desktop.target
