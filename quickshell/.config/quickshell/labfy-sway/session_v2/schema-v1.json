{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:labfy:sway:session-v2:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "metadata", "outputs", "applications", "window_slots", "workspaces", "focus"],
  "properties": {
    "schema": {"const": "labfy.sway.session-v2"}, "version": {"const": 1, "type": "integer"},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["created_ns", "sway_session", "reason"],
      "properties": {"created_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, "sway_session": {"$ref": "#/$defs/id"}, "reason": {"enum": ["manual", "logout", "reboot", "poweroff"]}}
    },
    "outputs": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"$ref": "#/$defs/place"}}}},
    "applications": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/application"}},
    "window_slots": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/slot"}},
    "workspaces": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["workspace", "output", "root"], "properties": {"workspace": {"$ref": "#/$defs/place"}, "output": {"$ref": "#/$defs/place"}, "root": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tree"}]}}}},
    "focus": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"},
    "place": {"type": "string", "pattern": "^[A-Za-z0-9 _:-]{1,64}$"},
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["application_id", "desktop_entry", "strategy", "expected_windows", "managed_by", "identity_provider"],
      "properties": {
        "application_id": {"$ref": "#/$defs/id"}, "desktop_entry": {"allOf": [{"$ref": "#/$defs/id"}, {"pattern": "\\.desktop$"}]},
        "strategy": {"enum": ["managed-autostart", "single-window", "multi-instance", "terminal", "browser-self-restore", "unknown"]},
        "expected_windows": {"type": "integer", "minimum": 1, "maximum": 256},
        "managed_by": {"enum": [null, "autostart", "sway-autostart"]}, "identity_provider": {"enum": [null, "firefox-session-window-uuid"]}
      }
    },
    "geometry": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "integer", "minimum": -100000, "maximum": 100000}, "y": {"type": "integer", "minimum": -100000, "maximum": 100000}, "width": {"type": "integer", "minimum": 1, "maximum": 32768}, "height": {"type": "integer", "minimum": 1, "maximum": 32768}}
    },
    "evidence": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"const": "firefox-session-window-uuid"}, "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"const": "application-singleton"}, "id": {"$ref": "#/$defs/id"}}}
      ]
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "application_id", "workspace", "tree_path", "state", "identity_requirement", "identity_evidence"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/id"}, "application_id": {"$ref": "#/$defs/id"}, "workspace": {"$ref": "#/$defs/place"},
        "tree_path": {"type": "array", "maxItems": 32, "items": {"type": "integer", "minimum": 0, "maximum": 31}},
        "identity_requirement": {"enum": ["exact", "best-effort", "interchangeable"]}, "identity_evidence": {"$ref": "#/$defs/evidence"},
        "state": {"type": "object", "additionalProperties": false, "required": ["floating", "geometry", "fullscreen", "scratchpad"], "properties": {"floating": {"type": "boolean"}, "geometry": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/geometry"}]}, "fullscreen": {"const": false}, "scratchpad": {"const": false}}}
      }
    },
    "tree": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["slot_id"], "properties": {"slot_id": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["layout", "children"], "properties": {"layout": {"enum": ["splith", "splitv", "tabbed", "stacked"]}, "children": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"$ref": "#/$defs/tree"}}}}
      ]
    }
  }
}
