# Animations désactivées dès le démarrage pour valider la stabilité.
animation_duration_ms 0

corner_radius 4
shadows enable
shadows_on_csd disable
shadow_blur_radius 10
shadow_color #00000055
shadow_inactive_color #00000035
shadow_offset 0 2

default_dim_inactive 0
scratchpad_minimize disable

# Limiter le flou aux surfaces shell pour éviter les grandes surfaces floutées.
blur disable
blur_xray disable
blur_passes 2
blur_radius 2

# Namespace observé dans get_outputs ; les autres couches restent intactes.
layer_effects "labfy-sway-bar" {
    blur enable
    blur_xray disable
    blur_ignore_transparent enable
    shadows enable
    corner_radius 4
}
