# Animations désactivées dès le démarrage pour valider la stabilité.
animation_duration_ms 0

corner_radius 4
shadows enable
shadows_on_csd disable
shadow_blur_radius $shadow_blur_radius
shadow_color $shadow_active
shadow_inactive_color $shadow_inactive
shadow_offset 0 2

default_dim_inactive 0
scratchpad_minimize disable

# Limiter le flou aux surfaces shell pour éviter les grandes surfaces floutées.
blur disable
blur_xray disable
blur_passes 2
blur_radius 2

# Namespace observé dans get_outputs ; les autres couches restent intactes.
layer_effects "labfy-sway-bar" {
    blur $bar_blur
    blur_xray disable
    blur_ignore_transparent enable
    shadows enable
    corner_radius 4
}

# CONTRACT: only the dock's layer surface receives blur; no window rule or
# focus/restore policy is changed. Its transparent input strip stays clear.
layer_effects "labfy-sway-dock" {
    blur $bar_blur
    blur_xray disable
    blur_ignore_transparent enable
    shadows disable
    corner_radius 25
}
