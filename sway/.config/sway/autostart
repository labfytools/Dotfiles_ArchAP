# =========== #
#  Autostart  #
# =========== #

# =================================================
# Transparence
# =================================================

# Listener IPC démarré une fois par session ; exec ne se rejoue pas au reload.
exec python3 ~/.config/sway/scripts/inactive-windows-transparency.py --opacity $inactive_opacity

# CONTRACT: QuickShell possède l'unique agent graphique Polkit de la session.
# Aucun deuxième agent n'est lancé par Sway à la prochaine connexion.

# =================================================
# Règles d'assignation automatique
# =================================================

assign [app_id="limusic-app"] workspace 10

# =================================================
# Lancement des applications
# =================================================

exec limusic-app
exec autotiling
