#!/usr/bin/env bash
set -euo pipefail
# CONTRACT: seul l'écran focalisé reçoit toggle ; aucun contenu de presse-papiers ne traverse IPC.
output="$(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused == true) | .name' | head -n 1)"
[[ -n "$output" ]] || exit 1
# Une relance ciblée de QuickShell laisse une courte fenêtre sans socket IPC.
for attempt in 1 2 3 4 5; do
    if quickshell ipc -c labfy-sway call "clipboardUi-$output" toggle >/dev/null 2>&1; then
        exit 0
    fi
    sleep 0.1
done
exit 1
